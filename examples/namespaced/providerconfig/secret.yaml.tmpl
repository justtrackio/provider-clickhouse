---
# Credentials for the ClickHouse provider.
#
# The provider serves three surfaces that authenticate differently. Supply the
# set(s) you actually need - every key is optional on its own, but the provider
# validates them as sets and will reject an incomplete or contradictory
# combination against this ProviderConfig rather than failing on every managed
# resource.
#
#   1. ClickHouse Cloud (services, ClickPipes, roles, Postgres, UDFs):
#        organization_id + token_key + token_secret   (all three required together)
#
#   2. ClickStack running on ClickHouse Cloud:
#        the Cloud set above, plus clickstack_service_id
#
#   3. Self-hosted ClickStack (OSS or EE):
#        clickstack_endpoint + clickstack_api_key      (both required together)
#
# clickstack_service_id is mutually exclusive with the self-hosted pair.
#
# Optional for any mode:
#   api_url          - override the ClickHouse OpenAPI endpoint
#   timeout_seconds  - HTTP client timeout (integer)
apiVersion: v1
kind: Secret
metadata:
  name: example-creds
  namespace: crossplane-system
type: Opaque
stringData:
  credentials: |
    {
      "organization_id": "aee076c1-3f83-4637-95b1-ad5a0a825b71",
      "token_key": "avhj1U5QCdWAE9CA9",
      "token_secret": "4b1dROiHQEuSXJHlV8zHFd0S7WQj7CGxz5kGJeJnca"
    }
---
# Self-hosted ClickStack only. Use this shape when you run HyperDX/ClickStack
# yourself and are not managing ClickHouse Cloud resources from the same
# ProviderConfig. Note that Cloud resources will error if used with this.
#
